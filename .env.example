# Security
REPOLENS_IGNORED_DIRECTORIES=[".git", "node_modules", "dist", "build", "coverage", "venv", ".venv", "__pycache__", ".cache", ".next", ".idea", ".vscode"]
REPOLENS_MAX_REPO_SIZE_MB=500
REPOLENS_MAX_FILE_SIZE_MB=10
REPOLENS_BINARY_EXTENSIONS=[".exe", ".dll", ".so", ".dylib", ".bin", ".dat", ".db", ".sqlite", ".jpg", ".jpeg", ".png", ".gif", ".ico", ".webp", ".pdf", ".mp4", ".zip", ".tar", ".gz"]

# Paths
# REPOLENS_TEMP_DIRECTORY=/tmp/repolens

# Logging
REPOLENS_LOG_LEVEL=INFO

# Phase 2: AI Investigation
REPOLENS_LLM_PROVIDER=ollama
REPOLENS_OLLAMA_MODEL=gpt-oss:120b-cloud
REPOLENS_OLLAMA_BASE_URL=<official cloud endpoint>
REPOLENS_TEMPERATURE=0.2
REPOLENS_MAX_TOKENS=4096
REPOLENS_AGENT_MAX_ITERATIONS=10
REPOLENS_AGENT_TIMEOUT_SECONDS=120
REPOLENS_PARALLEL_EXECUTION=false
